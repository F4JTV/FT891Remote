<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream description, for software centres. Configured by CMake: the
     launcher and the programs follow what the package holds. -->
<component type="desktop-application">
  <id>org.ft891remote.FT891Remote</id>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <name>FT891Remote</name>
  <summary>Operate a Yaesu FT-891 over the network</summary>
  <description>
    <p>
      A server runs next to the radio and shares its audio, PTT and every
      setting reachable over CAT; a Qt Quick front panel runs on the desktop
      or on Android. No Hamlib: the FT-891's own CAT protocol is spoken
      directly, so the FUNCTION keys, CW and FM settings, keyer memories and
      the whole MENU are all available remotely.
    </p>
  </description>
  <launchable type="desktop-id">@RR_METAINFO_LAUNCHABLE@</launchable>
  <developer id="org.ft891remote">
    <name>FT891Remote Community</name>
  </developer>
  <url type="homepage">https://github.com/</url>
  <categories>
    <category>HamRadio</category>
    <category>Network</category>
  </categories>
  <provides>
@RR_METAINFO_BINARIES@  </provides>
  <content_rating type="oars-1.1"/>
